NODE_ENV=production
BOOKING_BASE_PATH=/reservas-api
BOOKING_ALLOWED_ORIGINS=https://eslatin.com.co,https://www.eslatin.com.co

# Partner invitation access (FAW and iCAR only)
BOOKING_INVITE_REQUIRED=true
# Generate a random value of at least 32 characters and keep it server-side only.
BOOKING_INVITE_TOKEN_SECRET=replace_with_a_long_random_secret
# SHA-256 hashes of the uppercase invitation codes. Never upload the plain codes to the website.
BOOKING_PARTNER_INVITE_HASHES=FAW:replace_with_64_hex_characters,ICAR:replace_with_64_hex_characters
BOOKING_INVITE_TOKEN_TTL_SECONDS=1800

# Store customer records outside the application root so deployments do not overwrite them.
BOOKING_RECORDS_FILE=/home/your_cpanel_user/eslatin-reservas-data/bookings.json
# SHA-256 of the administrator password. Never store the plain password in cPanel.
BOOKING_ADMIN_PASSWORD_HASH=replace_with_64_hex_characters
BOOKING_ADMIN_TOKEN_SECRET=replace_with_a_long_random_secret
BOOKING_ADMIN_TOKEN_TTL_SECONDS=43200
BOOKING_PARTNER_CONFIG_FILE=/home/your_cpanel_user/eslatin-reservas-data/partner-config.json
BOOKING_PARTNER_MANAGER_TOKEN_SECRET=replace_with_a_long_random_secret
BOOKING_PARTNER_MANAGER_TOKEN_TTL_SECONDS=43200

DINGTALK_CLIENT_ID=replace_with_your_client_id
DINGTALK_CLIENT_SECRET=replace_with_your_client_secret
DINGTALK_STAFF_NAMES=Amos,Guillermo
DINGTALK_STAFF_USER_IDS=
BOOKING_STAFF_CITY_ASSIGNMENTS=Amos:bogota,Guillermo:bogota
DINGTALK_ORGANIZER_USER_ID=replace_with_eslatin_reserve_user_id
DINGTALK_ORGANIZER_NAME=EsLatin Reserve
DINGTALK_MOCK=false

BOOKING_CONFIRMATION_EMAIL_ENABLED=true
SPACEMAIL_SMTP_HOST=mail.spacemail.com
SPACEMAIL_SMTP_PORT=465
SPACEMAIL_SMTP_SECURE=true
SPACEMAIL_SMTP_USER=support@eslatin.com.co
SPACEMAIL_SMTP_PASSWORD=replace_with_your_spacemail_password
BOOKING_EMAIL_FROM=support@eslatin.com.co
BOOKING_EMAIL_REPLY_TO=info@eslatin.com.co
