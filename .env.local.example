# Local booking backend
BOOKING_BACKEND_PORT=3002
BOOKING_ALLOWED_ORIGINS=http://127.0.0.1:3001,http://localhost:3001

# Partner invitation access (legacy bootstrap; partners are managed in the admin page)
BOOKING_INVITE_REQUIRED=true
BOOKING_INVITE_TOKEN_SECRET=replace_with_a_long_random_secret
BOOKING_PARTNER_INVITE_HASHES=FAW:replace_with_64_hex_characters,ICAR:replace_with_64_hex_characters
BOOKING_INVITE_TOKEN_TTL_SECONDS=1800

# Persistent booking records and password-protected administration page
BOOKING_RECORDS_FILE=backend/.booking-records.json
BOOKING_ADMIN_PASSWORD_HASH=replace_with_sha256_of_the_admin_password
BOOKING_ADMIN_TOKEN_SECRET=replace_with_a_long_random_secret
BOOKING_ADMIN_TOKEN_TTL_SECONDS=43200
BOOKING_PARTNER_CONFIG_FILE=backend/.partner-config.json
BOOKING_PARTNER_MANAGER_TOKEN_SECRET=replace_with_a_long_random_secret
BOOKING_PARTNER_MANAGER_TOKEN_TTL_SECONDS=43200

# DingTalk enterprise internal app
# Client ID is the former AppKey. Never commit or share Client Secret.
DINGTALK_CLIENT_ID=your_client_id
DINGTALK_CLIENT_SECRET=your_client_secret
# Only these visible employees can be assigned. UserId is discovered automatically.
DINGTALK_STAFF_NAMES=Amos,Guillermo
# Optional city assignment for technical staff. Names must match DingTalk staff names.
BOOKING_STAFF_CITY_ASSIGNMENTS=Amos:bogota,Guillermo:bogota

# Dedicated non-field employee whose primary calendar creates invitations.
# This account is never included in availability checks or automatic assignment.
DINGTALK_ORGANIZER_USER_ID=your_organizer_user_id
# Optional fallback when the UserId is not configured. The name must match exactly.
# DINGTALK_ORGANIZER_NAME=EsLatin Reserve

# Optional after the one-time setup. If omitted, the backend reads its local metadata file.

# true = local simulation; false = call the real DingTalk API.
DINGTALK_MOCK=true

# Spaceship Spacemail confirmation messages
BOOKING_CONFIRMATION_EMAIL_ENABLED=false
SPACEMAIL_SMTP_HOST=mail.spacemail.com
SPACEMAIL_SMTP_PORT=465
SPACEMAIL_SMTP_SECURE=true
SPACEMAIL_SMTP_USER=support@eslatin.com.co
SPACEMAIL_SMTP_PASSWORD=your_spacemail_mailbox_password
BOOKING_EMAIL_FROM=support@eslatin.com.co
BOOKING_EMAIL_REPLY_TO=info@eslatin.com.co

# Frontend (used at build/dev time)
NEXT_PUBLIC_BOOKING_API_URL=http://127.0.0.1:3002
# Public browser key. Protect it in Geoapify with allowed origins/CORS.
NEXT_PUBLIC_GEOAPIFY_API_KEY=your_geoapify_api_key
